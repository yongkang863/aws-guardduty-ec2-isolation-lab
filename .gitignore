# Local Terraform state, backups, and state locks
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local variable values and saved plans
*.tfvars
*.tfvars.json
*.tfplan
*.tfplan.*
tfplan
tfplan.*
plan.out

# Downloaded providers and local Terraform working data
.terraform/

# Keep .terraform.lock.hcl in Git: it pins provider versions and checksums.

# Terraform crash logs and local CLI credentials/settings
crash.log
crash.*.log
.terraformrc
terraform.rc
.terraform.d/

# Local credentials and private keys
.aws/
.env
.env.*
!.env.example
*.pem
*.key

# Generated Lambda package and Python bytecode
/lambda/isolate_ec2.zip
__pycache__/
*.pyc
